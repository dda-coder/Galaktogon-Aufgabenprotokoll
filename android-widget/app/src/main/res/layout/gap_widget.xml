<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#172432">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GALAKTOGON // AUFGABEN" android:textColor="#83C9FF" android:textStyle="bold" android:textSize="14sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:text="↻" android:textColor="#FFFFFF" android:textSize="20sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Verbinde dein GAP-Konto …" android:textColor="#B2C1CD" android:textSize="12sp" />
    <TextView android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:text="Widget antippen, um GAP zu öffnen." android:textColor="#F2F7FB" android:textSize="13sp" />
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:paddingTop="5dp" android:text="GAP ÖFFNEN  ›" android:textColor="#83C9FF" android:textStyle="bold" android:textSize="11sp" />
</LinearLayout>
